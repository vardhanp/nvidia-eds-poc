{
  "name": "nvidia-contact-eds-poc",
  "version": "1.0.0",
  "description": "NVIDIA Contact page POC built with Adobe Edge Delivery Services (EDS) patterns",  
  "scripts": {
    "start": "npx serve . --listen 3001",
    "stop": "npx kill-port 3001",
    "build:json": "node scripts/build-json.js",	   
    "lint:js": "eslint . --ext .json,.js,.mjs",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "prepare": "husky",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",    
    "clear-cache": "node hlxAdmin.js cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardhanp/nvidia-eds-poc.git"
  },
  "author": "Nvidia",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/vardhanp/nvidia-eds-poc/issues"
  },
  "homepage": "https://github.com/vardhanp/nvidia-eds-poc#readme",
  "devDependencies": {
    "@adobe/aem-cli": "^16.0.0",
    "@babel/eslint-parser": "7.29.7",
    "@playwright/test": "^1.60.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "^9.0.0",
    "kill-port": "^2.0.0",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "serve": "^14.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@adobe/aem-cli": "^16.19.11",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2"
  },
  "license": "Apache-2.0"
}
